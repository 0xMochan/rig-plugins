#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
rig_bin=$(command -v rig) || { echo "Install Rig 0.46.0 before using this profile." >&2; exit 1; }
version=$("$rig_bin" --version)
if [ "$version" != "rig 0.46.0" ]; then
    echo "This profile requires rig 0.46.0; found: $version" >&2
    exit 1
fi

# The selected release is part of the profile. An ambient development checkout
# must not silently replace its registry dependencies.
unset RIG_SOURCE
export RIG_HOME="$repo/profile"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}"
if [ "${1-}" = setup ]; then
    shift
    [ "$#" -eq 0 ] || { echo "Usage: $0 setup" >&2; exit 1; }
    "$repo/scripts/setup-monty"
    "$repo/scripts/setup-codex-sandbox"
    set -- build
fi
exec "$rig_bin" "$@"
