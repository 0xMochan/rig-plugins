!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Python tooling and worker caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS metadata and editor temporary files.
.DS_Store
._*
*.swp
*.swo
*~

# Local-only research, planning, installation and validation notes.
